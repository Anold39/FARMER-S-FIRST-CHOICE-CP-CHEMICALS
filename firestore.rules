rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // staff_users: LOCKED DOWN. A document here can only be read or written by someone who
    // is currently signed in AND whose own email already has an approved entry in this same
    // collection -- i.e. only an existing staff member can see the staff list or approve/revoke
    // another staff member. This is what actually enforces "only staff can approve staff";
    // relying on the app's own JavaScript alone could always be bypassed by calling Firestore
    // directly from the browser console using the same public config already embedded in the
    // page. .lower() matches how staff-auth-data.js always normalizes the email used as this
    // document's own ID, so this stays correct regardless of the exact case Firebase Auth
    // returns in the sign-in token.
    match /staff_users/{email} {
      allow read, write: if request.auth != null &&
        exists(/databases/$(database)/documents/staff_users/$(request.auth.token.email.lower()));
    }

    // Everything else stays open for now -- appropriate for this project's current testing/
    // demonstration phase, with no real farmer data at stake yet. Each collection is listed
    // explicitly rather than with a wildcard: Firestore evaluates every matching rule and allows
    // a request if ANY of them permits it, so a catch-all placed below the strict staff_users
    // rule above would silently reopen that collection too, undoing the whole point of this file.
    match /products/{id}          { allow read, write: if true; }
    match /invoices/{id}          { allow read, write: if true; }
    match /escalations/{id}       { allow read, write: if true; }
    match /diagnosis_log/{id}     { allow read, write: if true; }
    match /blog_posts/{id}        { allow read, write: if true; }
    match /guides/{id}            { allow read, write: if true; }
    match /testimonials/{id}      { allow read, write: if true; }
    match /news_articles/{id}     { allow read, write: if true; }
    match /dropdown_options/{id}  { allow read, write: if true; }
  }
}
